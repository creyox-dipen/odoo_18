<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Eventhouse List View -->
    <record id="view_powerbi_eventhouse_list" model="ir.ui.view">
        <field name="name">powerbi.eventhouse.list</field>
        <field name="model">powerbi.eventhouse</field>
        <field name="arch" type="xml">
            <list string="Power BI Eventhouses" decoration-success="state=='published'">
                <field name="eventhouse_name"/>
                <field name="eventhouse_id"/>
                <field name="workspace_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="database_count"/>
                <field name="state" widget="badge" decoration-success="state=='published'"/>
                <field name="created_on"/>
            </list>
        </field>
    </record>

    <!-- Eventhouse Form View -->
    <record id="view_powerbi_eventhouse_form" model="ir.ui.view">
        <field name="name">powerbi.eventhouse.form</field>
        <field name="model">powerbi.eventhouse</field>
        <field name="arch" type="xml">
            <form string="Power BI Eventhouse">
                <header>
                    <button name="action_create_eventhouse" string="Create in Power BI" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_sync_eventhouse" string="Sync from Power BI" type="object"/>
                    <button name="action_fetch_databases" string="Fetch Databases" type="object"
                            class="btn-info" invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_publish,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_databases" type="object" class="oe_stat_button" icon="fa-server">
                            <field name="database_count" widget="statinfo" string="Databases"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="state != 'published'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="eventhouse_name" placeholder="e.g., Sales Data Eventhouse"/>
                        </h1>
                    </div>
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="config_id"/>
                            <field name="workspace_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="eventhouse_id" readonly="1"/>
                        </group>
                        <group name="metadata" string="Power BI Metadata">
                            <field name="created_by" readonly="1"/>
                            <field name="created_on" readonly="1"/>
                            <field name="last_updated_on" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KQL Databases" name="databases">
                            <field name="database_ids" nolabel="1">
                                <list>
                                    <field name="database_name"/>
                                    <field name="database_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="created_on"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the purpose of this eventhouse..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Eventhouse Search View -->
    <record id="view_powerbi_eventhouse_search" model="ir.ui.view">
        <field name="name">powerbi.eventhouse.search</field>
        <field name="model">powerbi.eventhouse</field>
        <field name="arch" type="xml">
            <search string="Power BI Eventhouses">
                <field name="eventhouse_name"/>
                <field name="eventhouse_id"/>
                <field name="workspace_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                <group expand="0" string="Group By">
                    <filter string="Workspace" name="workspace" domain="[]" context="{'group_by': 'workspace_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Eventhouse Action -->
    <record id="action_powerbi_eventhouse" model="ir.actions.act_window">
        <field name="name">Eventhouses</field>
        <field name="res_model">powerbi.eventhouse</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_powerbi_eventhouse_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Eventhouse
            </p>
            <p>
                Eventhouses provide real-time analytics capabilities and group
                multiple KQL databases for high-speed data processing.
            </p>
        </field>
    </record>

</odoo>