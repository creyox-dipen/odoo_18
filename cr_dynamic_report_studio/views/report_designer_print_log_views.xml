<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_designer_print_log_tree" model="ir.ui.view">
        <field name="name">report.designer.print.log.tree</field>
        <field name="model">report.designer.print.log</field>
        <field name="arch" type="xml">
            <list string="Print History" create="false" edit="false">
                <field name="print_date"/>
                <field name="template_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="user_id"/>
                <field name="pdf_size_kb"/>
                <field name="pdf_file_name" column_invisible="True"/>
                <field name="pdf_file" widget="binary" filename="pdf_file_name" string="Download"/>
            </list>
        </field>
    </record>

    <record id="view_report_designer_print_log_form" model="ir.ui.view">
        <field name="name">report.designer.print.log.form</field>
        <field name="model">report.designer.print.log</field>
        <field name="arch" type="xml">
            <form string="Print History" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                        <group>
                            <field name="print_date"/>
                            <field name="user_id"/>
                            <field name="pdf_size_kb"/>
                        </group>
                    </group>
                    <group string="Document">
                        <field name="pdf_file_name" invisible="1"/>
                        <field name="pdf_file" filename="pdf_file_name" widget="binary" string="PDF Document"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- We need to assign this view to the action -->
    <record id="action_report_designer_print_log" model="ir.actions.act_window">
        <field name="name">Print History</field>
        <field name="res_model">report.designer.print.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
