<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_report_designer">
            <field name="name">Visual Designer</field>
            <field name="description">Helps you manage Visual Designer permissions.</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_report_designer_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_report_designer"/>
        </record>

        <record id="group_report_designer_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_report_designer"/>
            <field name="implied_ids" eval="[(4, ref('group_report_designer_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
