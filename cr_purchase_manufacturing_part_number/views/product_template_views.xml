<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_manufacturing_part_no" model="ir.ui.view">
        <field name="name">product.template.form.inherit.manufacturing.part.no</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="after">
                <group>
                    <group>
                        <field name="manufacturing_part_no"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
