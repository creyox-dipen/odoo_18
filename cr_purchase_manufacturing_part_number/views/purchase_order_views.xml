<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_manufacturing_part_number" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.manufacturing.part.number</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">9999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="after">
                <field name="manufacturing_part_number" column_invisible="parent.form_type != 'purchase'"/>
            </xpath>
        </field>
    </record>
</odoo>
