<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_cr_payment_eupago" model="ir.ui.view">
        <field name="name">account.move.form.inherit.cr.payment.eupago</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_eupago_refund" invisible="1"/>
                <button name="action_eupago_refund" 
                        string="Refund via euPago" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="not can_eupago_refund"/>
            </xpath>
        </field>
    </record>
</odoo>
