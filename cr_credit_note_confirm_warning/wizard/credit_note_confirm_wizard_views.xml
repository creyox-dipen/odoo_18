<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_note_confirm_wizard_form" model="ir.ui.view">
        <field name="name">credit.note.confirm.wizard.form</field>
        <field name="model">credit.note.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Warning / Note">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        You are about to confirm a Credit Note. Are you sure you want to proceed?
                    </div>
                </sheet>
                <footer>
                    <button string="Cancel" class="btn-primary" special="cancel" data-hotkey="z"/>
                    <button string="Yes, Confirm" type="object" name="action_confirm" class="btn-secondary" data-hotkey="q"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
