<odoo>
    <data>
        <record id="view_gelato_product_price_wizard_form" model="ir.ui.view">
            <field name="name">gelato.product.price.wizard.form</field>
            <field name="model">gelato.product.price.wizard</field>
            <field name="arch" type="xml">
                <form string="Gelato Product Price Wizard">
                    <sheet>
                        <group>
                            <field name="product_uid" readonly="1"/>
                            <field name="price_line_ids">
                                <tree editable="bottom">
                                    <field name="country"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="currency"/>
                                    <field name="page_count"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>

                    <footer>
                        <button special="cancel" string="Cancel" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>


        <record id="action_gelato_product_price_wizard" model="ir.actions.act_window">
            <field name="name">Gelato Product Price Wizard</field>
            <field name="res_model">gelato.product.price.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_gelato_product_price_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
