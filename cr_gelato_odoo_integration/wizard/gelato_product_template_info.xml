<odoo>
    <!-- Wizard View for Gelato Template -->
    <record id="gelato_template_wizard_form" model="ir.ui.view">
        <field name="name">gelato.template.wizard.form</field>
        <field name="model">gelato.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Get Template">
                <group>
                    <field name="template_id" required="1"/>
                    <field name="template_name" readonly="1"/>
                    <field name="description" readonly="1"/>
                    <field name="preview_url" readonly="1"/>
                    <field name="product_type" readonly="1"/>
                    <field name="vendor" readonly="1"/>
                    <field name="variants" readonly="1"/>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
