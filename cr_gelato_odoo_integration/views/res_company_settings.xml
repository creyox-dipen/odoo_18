<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cr_res_config_settings_form_inherit" model="ir.ui.view">
        <field name="name">Res Config Settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="amazon_connector" position="after">
                <setting id="gelato" string="Gelato Sync" help="Use Gelato’s service to print and ship products on demand.">
                    <field name="is_gelato" widget="upgrade_boolean"/>
                    <div>
                        <label for="api_key_for_gelato" string="API Key" class="me-3"/>
                        <field name="api_key_for_gelato" password="True"/>
                    </div>
                    <div>
                        <label for="webhook_secret_for_gelato" string="Webhook Secret" class="me-3"/>
                        <field name="webhook_secret_for_gelato" password="True"/>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
