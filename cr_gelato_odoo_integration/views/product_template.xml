<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cr_product_template_inherit" model="ir.ui.view">
        <field name="name">Product Template Form Inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Gelato" name="gelato_data">
                    <group>
                        <group>
                            <field name="cr_image_ids" invisible="1"/>
                            <field name="cr_missing_images" invisible="1"/>
                            <field
                                    string="Template Reference"
                                    name="cr_template_ref"
                            />
                            <field
                                    string="Product UID"
                                    name="cr_product_uid"
                                    invisible="product_variant_count &gt; 1"
                            />

                            <field name="cr_image_ids" mode="tree,form">
                                <tree string="Print Images" editable="bottom">
                                    <field name="name"/>
                                    <field name="datas" widget="image"/>
                                </tree>
                                <form string="Edit Print Image">
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="datas" widget="image" nolabel="True"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <button
                                    string="Synchronize"
                                    type="object"
                                    name="action_sync_gelato_template_info"
                                    invisible="is_product_variant or not cr_template_ref"
                                    class="btn btn-primary"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="open_gelato_template_wizard"
                            type="object"
                            string="Get Template Info"
                            class="btn-primary"
                    invisible="not cr_template_ref"/>
            </xpath>
        </field>
    </record>



</odoo>